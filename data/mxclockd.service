# ~/.config/systemd/user/mxclockd.service  (or /usr/lib/systemd/user/)
# Enable with: systemctl --user enable --now mxclockd
[Unit]
Description=Clock daemon (alarms and timers)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.mechanix.services.Clock
ExecStart=/usr/bin/mxclockd
Restart=on-failure

[Install]
WantedBy=graphical-session.target
