# /usr/share/dbus-1/services/org.mechanix.services.Clock.service
# D-Bus activation: if the UI or launcher calls the daemon while it isn't
# running, the bus starts it (through systemd, via SystemdService).
[D-BUS Service]
Name=org.mechanix.services.Clock
Exec=/usr/bin/clockd
SystemdService=clockd.service
